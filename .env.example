# ローカル開発用の設定（start.bat が読み込む想定。コピーして .env を作成）

# DBの動かし方: auto / docker / local
#   auto   … ローカルにPostgreSQLサービスがあればそれを使い、無ければDockerを使う（既定）
#   docker … Dockerコンテナ manabi-db を使う（Docker Desktopが必要）
#   local  … ローカルインストールしたPostgreSQLサービスを使う（Docker不要）
DB_MODE=auto

# PostgreSQLの公開ポート
DB_PORT=55433

# バックエンド（FastAPI/uvicorn）
# Google OAuthクライアントに登録済みのリダイレクトURIに合わせて固定するポート。
# 変更する場合はGoogle Cloud Console側にもリダイレクトURIの追加登録が必要（下記GOOGLE_REDIRECT_URI参照）。
BACKEND_PORT=5177
# フロントエンド（Vite）。使用中の場合Viteが自動で次の空きポートに割り当てる
FRONTEND_PORT=5180

# ---------------------------------------------------------------------------
# 開発用ログイン（Google OAuthを設定するまでの間、ダミーアカウントでログインする）
# ---------------------------------------------------------------------------

# 1にすると /api/auth/dev-login が有効になり、ログイン画面にダミーアカウント選択欄が出る。
# GOOGLE_CLIENT_ID/SECRET を設定すると自動的に無効になる（本番と同じ経路を強制するため）。
DEV_AUTH=1

# ---------------------------------------------------------------------------
# 以下はローカル開発では未設定でよい（本番ホスティング/Supabase 用。本番は接続先の環境変数として設定する）
# ---------------------------------------------------------------------------

# 実行環境の識別。production にすると以下が自動で切り替わる:
#   ・開発用ログイン(/api/auth/dev-login)を強制無効化（DEV_AUTH=1 でも有効にならない）
#   ・セッションCookieに Secure 属性を付与
#   ・起動時の自動スキーマ適用(CREATE TABLE)を抑止
#   ・JWT_SECRET 未設定なら起動時にエラー
#APP_ENV=production

# Supabase の接続文字列。Supabase ダッシュボード > Connect から取得する。
# 末尾に ?sslmode=require を付けること。パスワードに記号が含まれる場合はURLエンコードする。
#DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# セッションJWTの署名鍵。本番では必須。十分に長いランダム文字列を設定する
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
#JWT_SECRET=

# Google OAuth（A-01/A-02）。Google Cloud Console で作成したOAuthクライアントの値。
# 設定するとDEV_AUTHより優先され、開発用ログインは自動的に無効になる。
#GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=
# コールバックURL。未設定ならリクエストのホストから自動導出するため通常は不要だが、
# ローカル開発はフロントエンド(Vite)経由でA-01を呼ぶとリクエストのHostがフロントエンドの
# ポートになり自動導出に失敗するため、明示的に指定することを推奨する。
#GOOGLE_REDIRECT_URI=http://localhost:5177/api/auth/callback
# ログインを許可するメールアドレスのドメイン（カンマ区切りで複数可）
ALLOWED_DOMAINS=kogasoftware.com
# ログイン成功後のリダイレクト先。本番は未設定のままでよい（相対"/"、フロントエンドと同一オリジン
# で配信されるため）が、ローカル開発はフロントエンドが別ポートのため明示する。
#FRONTEND_URL=http://localhost:5180/

# ---------------------------------------------------------------------------
# AI機能（F-08教材AIレビュー・F-20〜F-23。Manabi側で従量課金が発生する経路）
# ローカルでも設定すれば動く。未設定なら該当機能はエラーになるため、当面は未設定のままでよい。
# ---------------------------------------------------------------------------

# Anthropic の APIキー。https://console.anthropic.com/ で発行する。
#ANTHROPIC_API_KEY=sk-ant-...

# 使用するモデルはコスト管理のため常に最安モデル（claude-haiku-4-5）に固定されており、
# 設定不可（ai_client.py参照。以前あったS-10「システム設定」タブでの選択・本変数による
# 上書きは廃止した。2026-09-03）。

# ---------------------------------------------------------------------------
# Slack個人連携（F-12 Slack受講催促通知）・ファイルストレージ
# 未設定でも他機能には影響しない（S-15の「Slack連携する」ボタンが無効表示になるだけ）。
# ---------------------------------------------------------------------------

# Slackアプリ（api.slack.com/apps）のOAuth&Permissionsで作成。User Token Scopesのみ設定する
# （chat:write, identity.basic。Bot User・Bot Token Scopeは使わない）。
#SLACK_CLIENT_ID=
#SLACK_CLIENT_SECRET=
# コールバックURL。Slackアプリ側のRedirect URLsに事前登録が必要。未設定ならリクエストの
# ホストから自動導出するが、Google同様ローカル開発では明示指定を推奨する。
#SLACK_REDIRECT_URI=http://localhost:5177/api/slack/callback

# Supabase Storage（教材添付ファイル・ユーザーアイコン用）。
# URL/SERVICE_KEYのいずれかが未設定の間はローカルのbackend/uploads/へ保存する簡易実装に自動的に切り替わる
# （storage.py参照。詳細設計書07_教材連携詳細.html 7.6節）。本番デプロイ時にのみ設定する。
#SUPABASE_URL=https://xxxxxxxx.supabase.co
#SUPABASE_SERVICE_KEY=
#SUPABASE_STORAGE_BUCKET=manabi-uploads

# アップロードサイズ上限（MB）
MAX_ATTACHMENT_SIZE_MB=200
MAX_ICON_SIZE_MB=2
